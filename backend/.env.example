# Copy this file to `.env` and fill in real values.
MONGO_URI=your_mongodb_connection_string
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=generate_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (used in invitation / reset-password emails & links)
FRONTEND_URL=http://localhost:3000

# Email (SMTP) — used by welcome / reset-password / invitation emails
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Imizi <no-reply@imizi.app>

# Invitation link lifetime in days
INVITE_TTL_DAYS=7
